# =====================================================================
#  Шаблон переменных окружения. Скопируйте в .env:  make init
#  (или cp example.env .env) и замените пароли на свои.
#  Файл .env в git НЕ попадает (см. .gitignore).
#  Комментарии только на отдельных строках: файл читают и docker compose,
#  и bash (source), и PowerShell.
# =====================================================================

# === Режим ===
# true — эмуляция: всё локально в Docker, хостинг подменён скриптом mock_vps.py
# false — боевой режим: скрипты работают с реальным VPS из блока ниже
MOCK_MODE=true
# Имя проекта: префикс контейнеров, сетей и томов
PROJECT_NAME=autello_barskiy
COMPOSE_PROJECT_NAME=autello_barskiy

# === VPS (ihor.online / reg.ru → «Виртуальные серверы» → сервер → «Инструкция») ===
# IP-адрес сервера из письма/панели хостинга (в эмуляции — адрес из 203.0.113.0/24)
VPS_HOST=203.0.113.10
# Пользователь SSH (хостинг выдаёт root)
VPS_USER=root
# Путь к приватному SSH-ключу на вашей машине (создаст setup_ssh_key.sh, если его нет)
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519
# Каталог проекта на сервере
VPS_PROJECT_DIR=/opt/autello_barskiy
# Домен — необязательно (если куплен на reg.ru и A-запись смотрит на VPS_HOST)
VPS_DOMAIN=
# API-ключ хостинга. В задании не нужен — заготовка на случай автоматизации
# (reg.ru → «Настройки» → «API»). В эмуляции не используется.
HOSTING_API_KEY=mock_key_replace_me

# === PostgreSQL (наружу НЕ публикуется, только сеть internal) ===
POSTGRES_DB=autello
POSTGRES_USER=autello
POSTGRES_PASSWORD=change_me_strong

# === pgAdmin ===
# Логин в веб-интерфейс pgAdmin. Домен .local pgAdmin считает невалидным — используйте обычный.
PGADMIN_DEFAULT_EMAIL=admin@autello.ru
PGADMIN_DEFAULT_PASSWORD=change_me
# Порт pgAdmin на хосте: http://<host>:5050
PGADMIN_PORT=5050

# === Docker Registry ===
# Адрес реестра, с которым работает docker push/pull (локально — localhost, на VPS — IP или домен)
REGISTRY_HOST=localhost
# На macOS порт 5000 занят AirPlay Receiver, поэтому по умолчанию 5001.
# На VPS можно оставить 5000.
REGISTRY_PORT=5001
# Веб-интерфейс реестра (joxit/docker-registry-ui)
REGISTRY_UI_PORT=8080
# Пользователь реестра — его создаёт registry/create-user.sh (make user)
REGISTRY_USER=admin
REGISTRY_PASSWORD=change_me

# === Nginx / Watchtower ===
# Порт сайта на хосте
HTTP_PORT=80
# Как часто Watchtower проверяет новые образы, секунд
WATCHTOWER_POLL_INTERVAL=300

# === Часть 2: backend, Swagger, админка, GPT ===
# true — временно открыть Swagger на /docs (nginx проксирует /docs и /openapi.json); в продакшене false
DOCS_ENABLED=true
# Порт uvicorn внутри контейнера backend (наружу НЕ публикуется, nginx ходит на backend:<порт>)
BACKEND_INTERNAL_PORT=8000
# Откуда браузеру разрешены запросы к API (через запятую). Фронт и API на одном домене, поэтому хватает своего адреса
CORS_ORIGINS=http://localhost
# Заготовка для авторизации /admin (следующий урок). Сейчас не проверяется
ADMIN_TOKEN=change_me
# Ключ OpenAI понадобится в следующей части (GPT-анализ лидов). Сейчас не используется: при MOCK_MODE=true ответ генерирует scripts/mock_gpt.py
OPENAI_API_KEY=mock_sk_replace_me
# Модель для будущего GPT-анализа лидов
OPENAI_MODEL=gpt-4o-mini
