# =====================================================================
#  Nginx Autello: статика фронтенда (frontend/dist) + прокси /api/ на backend.
#  Это ШАБЛОН. При старте образ nginx прогоняет nginx/templates/**/*.template
#  через envsubst и пишет результат в /etc/nginx/conf.d/ (подставляются только
#  переменные из NGINX_ENVSUBST_FILTER: DOCS_ENABLED, BACKEND_INTERNAL_PORT).
#  Посмотреть итоговый конфиг: docker exec nginx cat /etc/nginx/conf.d/default.conf
# =====================================================================

# DNS Docker. Имя backend резолвится заново каждые 10 с: после того как Watchtower
# пересоздаст контейнер backend (новый IP), nginx не будет отдавать 502.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    # Редиректы (например /admin → /admin/) — относительные, без внутреннего порта/хоста
    absolute_redirect off;
    charset utf-8;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/conf.d/snippets/security_headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------- API ----------
    # БЕЗ завершающего слэша и без URI-части: запрос /api/applications уходит
    # на backend как /api/applications — путь не переписывается и не обрезается.
    # (proxy_pass http://backend:8000/ срезал бы /api/ → 404/405 на стороне FastAPI.)
    # Адрес в переменной — чтобы работал resolver выше; при переменной без URI
    # nginx тоже передаёт исходный путь как есть.
    location /api/ {
        set $backend_upstream http://backend:${BACKEND_INTERNAL_PORT};
        proxy_pass $backend_upstream;
        include /etc/nginx/conf.d/snippets/proxy_params.conf;
        client_max_body_size 1m;
    }

    # ---------- Swagger ----------
    # docs_true.conf проксирует /docs и /openapi.json, docs_false.conf отвечает 404.
    # Выбор — по DOCS_ENABLED из .env (true/false).
    include /etc/nginx/conf.d/docs/docs_${DOCS_ENABLED}.conf;

    # ---------- Статика сборки webpack ----------
    # Имена с contenthash → кешируем на год. try_files ... =404: отсутствующий
    # CSS/JS отдаёт честный 404, а НЕ index.html (иначе браузер получит text/html
    # вместо text/css и выдаст «Refused to apply style… MIME type»).
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/snippets/security_headers.conf;
        access_log off;
    }

    # ---------- Админка ----------
    # $uri/index.html вместо $uri/: /admin открывается сразу, без 301 на /admin/
    location /admin {
        try_files $uri $uri/index.html /admin/index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/snippets/security_headers.conf;
    }

    # ---------- Клиентская страница ----------
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/snippets/security_headers.conf;
    }
}
