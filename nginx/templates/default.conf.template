# =====================================================================
#  Nginx Autello (часть 3): HTTPS + статика фронтенда + прокси /api/ на backend.
#  Это ШАБЛОН. При старте образ nginx прогоняет nginx/templates/**/*.template
#  через envsubst и пишет результат в /etc/nginx/conf.d/ (подставляются только
#  переменные из NGINX_ENVSUBST_FILTER: DOCS_ENABLED, BACKEND_INTERNAL_PORT, NGINX_MODE).
#  Посмотреть итоговый конфиг: docker exec nginx cat /etc/nginx/conf.d/default.conf
#
#  Структура:
#    snippets/site.conf        — сам сайт: /, /admin, /assets, /api/, /docs (общий для 80 и 443)
#    modes/dev.conf            — make dev:    порт 80 отдаёт сайт как есть (удобно для отладки)
#    modes/secure.conf         — make secure: порт 80 → 301 на https, 8000 и 5432 → 403
# =====================================================================

# DNS Docker. Имя backend резолвится заново каждые 10 с: после того как Watchtower
# пересоздаст контейнер backend (новый IP), nginx не будет отдавать 502.
resolver 127.0.0.11 valid=10s ipv6=off;

# ---------- Порт 80 и заглушки — зависят от режима (dev / secure) ----------
include /etc/nginx/conf.d/modes/${NGINX_MODE}.conf;

# ---------- HTTPS: основной вход на сайт ----------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    # Сертификат: локально — самоподписанный (scripts/gen_selfsigned.sh),
    # на VPS — Let's Encrypt (scripts/letsencrypt.sh). Пути в контейнере фиксированы,
    # на хосте задаются SSL_CERT_PATH / SSL_KEY_PATH в .env.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Только TLS 1.2+; современные шифры выбирает клиент (рекомендация Mozilla «intermediate»)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/conf.d/snippets/site.conf;
}
